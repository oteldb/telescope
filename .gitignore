dist
coverage.txt
.task

# Editors and agents.
.idea
.vscode
.claude
.mcp.json

# The sandbox this is developed in overlays a shell profile and its own git and
# ripgrep config on the working directory. None of it is the project's.
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc
.gitmodules
